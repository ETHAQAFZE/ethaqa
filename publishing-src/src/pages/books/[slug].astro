---
// ============================================================
// Ethaqa Publishing — Book Detail
// Route: /publishing/books/[slug]/
// Version: 1.0.0
//
// Renders a single published book with full metadata,
// cover, description, purchase links, and structured data.
// Draft books are excluded from routing.
// ============================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { Image } from 'astro:assets';
import { getPublishedBooks } from '../../lib/books';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

// ------------------------------------------------------------
// Dynamic route: one page per published book
// ------------------------------------------------------------
export async function getStaticPaths() {
  const books = await getPublishedBooks();
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { data } = book;

// ------------------------------------------------------------
// Resolve relationships
// ------------------------------------------------------------
const authors = await Promise.all(
  data.authors.map((a) => getEntry(a))
);
const categories = await Promise.all(
  data.categories.map((c) => getEntry(c))
);
const primaryCategory = categories[0];

// ------------------------------------------------------------
// Format labels for display
// ------------------------------------------------------------
const formatLabels: Record<string, string> = {
  paperback: 'Paperback',
  hardcover: 'Hardcover',
  ebook: 'eBook',
  audiobook: 'Audiobook',
};
const formatList = data.format.map((f) => formatLabels[f] ?? f).join(' · ');

// ------------------------------------------------------------
// Publication date formatting
// ------------------------------------------------------------
const publicationDate = data.publicationDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// ------------------------------------------------------------
// Purchase links, if any
// ------------------------------------------------------------
const purchaseLinks = data.purchaseLinks ?? {};
const purchaseEntries = Object.entries(purchaseLinks).filter(
  ([, url]) => typeof url === 'string' && url.length > 0
);
const purchaseLabels: Record<string, string> = {
  amazon: 'Amazon',
  kindle: 'Kindle',
  noon: 'Noon',
  barnesAndNoble: 'Barnes & Noble',
  directPdf: 'Direct PDF',
};

// ------------------------------------------------------------
// Page metadata
// ------------------------------------------------------------
const title = `${data.title} — Ethaqa Publishing`;
const description = data.shortDescription || data.description.slice(0, 155);

// ------------------------------------------------------------
// JSON-LD — Book schema
// ------------------------------------------------------------
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: data.title,
    ...(data.subtitle && { alternativeHeadline: data.subtitle }),
    isbn: data.isbn13,
    numberOfPages: data.pageCount,
    inLanguage: data.language,
    bookFormat: 'https://schema.org/Paperback',
    author: authors.map((a) => ({
      '@type': 'Person',
      name: a.data.name,
    })),
    publisher: {
      '@type': 'Organization',
      name: data.publisher,
    },
    datePublished: data.publicationDate.toISOString().split('T')[0],
    description: data.description,
    image: new URL(data.cover.src.src, Astro.site).toString(),
    ...(purchaseEntries.length > 0 && {
      offers: purchaseEntries.map(([, url]) => ({
        '@type': 'Offer',
        url,
        availability: 'https://schema.org/InStock',
      })),
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Publishing',
        item: new URL('/publishing/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Books',
        item: new URL('/publishing/books/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: data.title,
        item: new URL(`/publishing/books/${book.id}/`, Astro.site).toString(),
      },
    ],
  },
];

// ------------------------------------------------------------
// Breadcrumbs for PageHero
// ------------------------------------------------------------
const breadcrumbs = [
  { label: 'Publishing', href: '/publishing/' },
  { label: 'Books', href: '/publishing/books/' },
  { label: data.title },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="book"
  ogImage={data.cover.src.src}
  jsonLd={jsonLd}
  bodyClass="page-book-detail"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow={primaryCategory ? primaryCategory.data.name : 'Book'}
    title={data.title}
    lead={data.shortDescription}
  />

  <!-- ============================================================
       BOOK BODY
       ============================================================ -->
  <section class="section">
    <div class="wrap book-layout">

      <!-- LEFT: COVER -->
      <aside class="book-cover-wrap">
        <div class="book-cover">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            width={600}
            height={900}
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="book-cover-img"
          />
        </div>

        {purchaseEntries.length > 0 && (
          <div class="purchase-links">
            <div class="purchase-label">Available at</div>
            {purchaseEntries.map(([key, url]) => (
              <a
                href={url}
                class="purchase-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {purchaseLabels[key] ?? key}
              </a>
            ))}
          </div>
        )}
      </aside>

      <!-- RIGHT: DETAILS -->
      <div class="book-details">

        <!-- Description -->
        <div class="book-section">
          <h2 class="book-section-title">About this book</h2>
          <p class="book-description">{data.description}</p>
        </div>

        <!-- Author(s) -->
        {authors.length > 0 && (
  <div class="book-section">
    <h2 class="book-section-title">
      {authors.length > 1 ? 'Authors' : 'Author'}
    </h2>
    <div class="author-list">
      {authors.map((author) => (
        <a href={`/publishing/authors/${author.id}/`} class="author-card">
          <div class="author-name">{author.data.name}</div>
          {author.data.bio && (
            <p class="author-bio">{author.data.bio}</p>
          )}
        </a>
      ))}
    </div>
  </div>
)}

        <!-- Metadata -->
        <div class="book-section">
          <h2 class="book-section-title">Details</h2>
          <dl class="book-meta">
            <div class="meta-row">
              <dt>Published</dt>
              <dd>{publicationDate}</dd>
            </div>
            <div class="meta-row">
              <dt>Formats</dt>
              <dd>{formatList}</dd>
            </div>
            <div class="meta-row">
              <dt>Pages</dt>
              <dd>{data.pageCount}</dd>
            </div>
            {data.ageRange && (
              <div class="meta-row">
                <dt>Age Range</dt>
                <dd>{data.ageRange.min}–{data.ageRange.max} years</dd>
              </div>
            )}
            <div class="meta-row">
              <dt>Language</dt>
              <dd>{data.language === 'en' ? 'English' : data.language.toUpperCase()}</dd>
            </div>
            <div class="meta-row">
              <dt>ISBN-13</dt>
              <dd class="mono-value">{data.isbn13}</dd>
            </div>
            <div class="meta-row">
              <dt>Publisher</dt>
              <dd>{data.imprint}</dd>
            </div>
            {categories.length > 1 && (
              <div class="meta-row">
                <dt>Categories</dt>
                <dd>
                  {categories.map((cat, i) => (
                    <>
                      <a href={`/publishing/categories/${cat.id}/`}>{cat.data.name}</a>
                      {i < categories.length - 1 && ', '}
                    </>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </div>

        <!-- Keywords / tags -->
        {data.keywords.length > 0 && (
          <div class="book-section">
            <h2 class="book-section-title">Subjects</h2>
            <div class="keyword-list">
              {data.keywords.map((kw) => (
                <span class="keyword">{kw}</span>
              ))}
            </div>
          </div>
        )}

      </div>

    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     LAYOUT
     ============================================================ */

  .section {
    padding: clamp(80px, 10vw, 120px) 0;
  }

  .book-layout {
    display: grid;
    grid-template-columns: minmax(280px, 400px) 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  @media (max-width: 900px) {
    .book-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     COVER
     ============================================================ */

  .book-cover-wrap {
    position: sticky;
    top: 120px;
  }

  @media (max-width: 900px) {
    .book-cover-wrap {
      position: static;
      max-width: 320px;
      margin-inline: auto;
    }
  }

  .book-cover {
    aspect-ratio: 2 / 3;
    background: var(--color-mist);
    box-shadow: var(--shadow-book);
    overflow: hidden;
  }

  .book-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ============================================================
     PURCHASE LINKS
     ============================================================ */

  .purchase-links {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .purchase-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-slate);
    margin-bottom: 6px;
  }

  .purchase-link {
    display: block;
    padding: 14px 20px;
    background: var(--color-navy);
    color: var(--color-paper);
    text-decoration: none;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all var(--duration-base) var(--ease-standard);
  }

  .purchase-link:hover {
    background: var(--color-navy-deep);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  /* ============================================================
     DETAILS
     ============================================================ */

  .book-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .book-section-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-navy);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: var(--border-hairline);
  }

  .book-description {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #2A3441;
    max-width: 60ch;
  }

  /* ============================================================
     AUTHOR(S)
     ============================================================ */

  .author-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .author-card {
    display: block;
    padding: 20px 24px;
    border: var(--border-hairline);
    text-decoration: none;
    transition: all var(--duration-base) var(--ease-standard);
  }

  .author-card:hover {
    border-color: rgba(184, 147, 63, 0.4);
    background: var(--color-mist);
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 4px;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
    margin-bottom: 12px;
  }

  .author-bio {
    font-size: 0.92rem;
    color: #2A3441;
    line-height: 1.6;
    margin: 0;
  }

  /* ============================================================
     METADATA
     ============================================================ */

  .book-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    padding-bottom: 12px;
    border-bottom: var(--border-hairline);
    font-size: 0.92rem;
  }

  .meta-row:last-child {
    border-bottom: none;
  }

  .meta-row dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-slate);
    padding-top: 3px;
  }

  .meta-row dd {
    color: var(--color-navy);
    font-weight: 500;
    margin: 0;
  }

  .meta-row dd a {
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 1px solid rgba(11, 47, 91, 0.2);
    transition: all var(--duration-base) var(--ease-standard);
  }

  .meta-row dd a:hover {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }

  .mono-value {
    font-family: var(--font-mono);
    font-size: 0.85rem !important;
    letter-spacing: 0.04em;
  }

  /* ============================================================
     KEYWORDS
     ============================================================ */

  .keyword-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .keyword {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    background: var(--color-mist);
    color: var(--color-slate);
    border: var(--border-hairline);
  }
</style>