---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { Image } from 'astro:assets';
import { getPublishedBooks } from '../../lib/books';
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';

// ------------------------------------------------------------
// Dynamic route: one page per published book
// ------------------------------------------------------------
export async function getStaticPaths() {
  const books = await getPublishedBooks();
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { data } = book;

// ------------------------------------------------------------
// Resolve relationships (Authors & Categories)
// ------------------------------------------------------------
const authors = await Promise.all(
  data.authors.map((a) => getEntry(a))
);

const categories = await Promise.all(
  data.categories.map((c) => getEntry(c))
);

const primaryCategory = categories[0];
const purchaseLinks = data.purchaseLinks ?? {};

// ------------------------------------------------------------
// Formatting helpers
// ------------------------------------------------------------
const publicationDate = data.publicationDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formatLabels: Record<string, string> = {
  paperback: 'Paperback',
  ebook: 'eBook',
  hardcover: 'Hardcover',
};

const formatList = data.format
  .map((f) => formatLabels[f] ?? f)
  .join(' · ');

const title = `${data.title} — Ethaqa Publishing`;
const description = data.shortDescription || data.description.slice(0, 155);

// ------------------------------------------------------------
// Structured Data (JSON-LD)
// ------------------------------------------------------------
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: data.title,
    ...(data.subtitle && { alternativeHeadline: data.subtitle }),
    isbn: data.asin || data.isbn13, // Prefer ASIN if ISBN is missing
    numberOfPages: data.pageCount,
    inLanguage: data.language,
    bookFormat: 'https://schema.org/Paperback',
    author: authors.map((a) => ({
      '@type': 'Person',
      name: a?.data.name,
    })),
    publisher: {
      '@type': 'Organization',
      name: data.publisher,
    },
    datePublished: data.publicationDate.toISOString().split('T')[0],
    description: data.description,
    image: new URL(data.cover.src.src, Astro.site).toString(),
    ...(purchaseLinks.amazon && {
      offers: {
        '@type': 'Offer',
        url: purchaseLinks.amazon,
        availability: 'https://schema.org/InStock',
      },
    }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Books',
        item: new URL('/publishing/books/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: data.title,
        item: new URL(`/publishing/books/${book.id}/`, Astro.site).toString(),
      },
    ],
  },
];

// ------------------------------------------------------------
// Breadcrumbs for UI
// ------------------------------------------------------------
const breadcrumbs = [
  { label: 'Books', href: '/publishing/books/' },
  { label: data.title },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="book"
  ogImage={data.cover.src.src}
  jsonLd={jsonLd}
  bodyClass="page-book-detail"
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow={primaryCategory ? primaryCategory.data.name : 'Book'}
    title={data.title}
  />

  <section class="section">
    <div class="container">
      <div class="book-layout">
        
        <!-- Left Column: Cover & Buy Links -->
        <aside class="book-sidebar">
          <div class="book-cover-wrapper">
            <Image
              src={data.cover.src}
              alt={data.cover.alt}
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 400px"
              class="book-cover-image"
              loading="eager"
            />
          </div>

          {purchaseLinks.amazon && (
            <div class="book-actions">
              <a 
                href={purchaseLinks.amazon} 
                class="btn btn-accent btn-block" 
                target="_blank" 
                rel="noopener noreferrer"
              >
                Buy on Amazon
              </a>
              <p class="price-hint">Paperback · $12.99 USD</p>
            </div>
          )}
        </aside>

        <!-- Right Column: Details -->
        <div class="book-content">
          <div class="book-section">
            <h2 class="book-section-title">About this book</h2>
            <p class="book-description">{data.description}</p>
          </div>

          {authors.length > 0 && (
            <div class="book-section">
              <h2 class="book-section-title">
                {authors.length > 1 ? 'Authors' : 'Author'}
              </h2>
              <div class="author-list">
                {authors.map((author) => (
                  <a href={`/publishing/authors/${author?.id}/`} class="author-card">
                    <div class="author-name">{author?.data.name}</div>
                    {author?.data.bio && (
                      <p class="author-bio">{author.data.bio}</p>
                    )}
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="book-section">
            <h2 class="book-section-title">Details</h2>
            <dl class="book-metadata">
              <div>
                <dt>Published</dt>
                <dd>{publicationDate}</dd>
              </div>

              <div>
                <dt>Formats</dt>
                <dd>{formatList}</dd>
              </div>

              <div>
                <dt>Pages</dt>
                <dd>{data.pageCount}</dd>
              </div>

              {data.trimSize && (
                <div>
                  <dt>Dimensions</dt>
                  <dd>{data.trimSize}</dd>
                </div>
              )}

              {data.ageRange && (
                <div>
                  <dt>Age Range</dt>
                  <dd>{data.ageRange.min}–{data.ageRange.max} years</dd>
                </div>
              )}

              <div>
                <dt>Language</dt>
                <dd>{data.language === 'en' ? 'English' : data.language.toUpperCase()}</dd>
              </div>

              {data.isbn13 && (
                <div>
                  <dt>ISBN-13</dt>
                  <dd class="mono-value">{data.isbn13}</dd>
                </div>
              )}

              {data.asin && (
                <div>
                  <dt>ASIN</dt>
                  <dd class="mono-value">{data.asin}</dd>
                </div>
              )}

              <div>
                <dt>Publisher</dt>
                <dd>{data.publisher}</dd>
              </div>
            </dl>
          </div>

          {data.keywords.length > 0 && (
            <div class="book-section">
              <h2 class="book-section-title">Subjects</h2>
              <div class="tag-list">
                {categories.map((cat) => (
                  <a href={`/publishing/categories/${cat?.id}/`} class="tag">
                    {cat?.data.name}
                  </a>
                ))}
                {data.keywords.map((kw) => (
                  <span class="tag">{kw}</span>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     LAYOUT
     ============================================================ */
  .section {
    padding: clamp(80px, 10vw, 120px) 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .book-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .book-layout {
      grid-template-columns: 360px 1fr;
      gap: 64px;
    }
  }

  /* ============================================================
     SIDEBAR (Cover & Buy)
     ============================================================ */
  .book-sidebar {
    position: sticky;
    top: 100px;
  }

  .book-cover-wrapper {
    background: var(--gray-light);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-bottom: 24px;
  }

  .book-cover-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .book-actions {
    text-align: center;
  }

  .btn-block {
    display: block;
    width: 100%;
    text-align: center;
    padding: 14px 24px;
    font-size: 1.1rem;
  }

  .price-hint {
    margin-top: 12px;
    font-size: 0.9rem;
    color: #64748b;
  }

  /* ============================================================
     CONTENT SECTIONS
     ============================================================ */
  .book-section {
    margin-bottom: 48px;
  }

  .book-section:last-child {
    margin-bottom: 0;
  }

  .book-section-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--gray-mid);
  }

  .book-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-soft);
  }

  /* ============================================================
     AUTHOR CARD
     ============================================================ */
  .author-list {
    display: grid;
    gap: 16px;
  }

  .author-card {
    display: block;
    padding: 24px;
    background: white;
    border: 1px solid var(--gray-mid);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .author-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .author-name {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 8px;
  }

  .author-bio {
    font-size: 0.95rem;
    color: var(--text-soft);
    line-height: 1.5;
  }

  /* ============================================================
     METADATA (DL)
     ============================================================ */
  .book-metadata {
    display: grid;
    gap: 0;
  }

  .book-metadata > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--gray-mid);
  }

  .book-metadata > div:last-child {
    border-bottom: none;
  }

  @media (min-width: 600px) {
    .book-metadata > div {
      grid-template-columns: 200px 1fr;
      gap: 24px;
      align-items: baseline;
    }
  }

  .book-metadata dt {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: #64748b;
  }

  .book-metadata dd {
    font-size: 1rem;
    color: var(--text-dark);
    margin: 0;
  }

  .mono-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.02em;
  }

  /* ============================================================
     TAGS (Subjects)
     ============================================================ */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tag {
    display: inline-block;
    padding: 6px 16px;
    background: var(--gray-light);
    border: 1px solid var(--gray-mid);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-soft);
    text-decoration: none;
    transition: all 0.2s;
  }

  a.tag:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }
</style>