# ============================================================
# Ethaqa Platform — Environment Variables
# ============================================================
# Copy this file to `.env` for local development.
# Never commit `.env` — it contains real values.
# In Cloudflare Pages, set these in the dashboard.
# ============================================================

# Canonical origin — used by Astro.site for absolute URLs
# Note: Astro reads `site` from astro.config.mjs, not from .env
# by default. Keep this in sync with the config value if changed.
PUBLIC_SITE_URL=https://www.ethaqa.com

# Google Analytics 4 measurement ID
PUBLIC_GA_ID=G-XXXXXXXXXX

# Web3Forms access key (contact form submissions)
PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Cloudflare Web Analytics beacon token
PUBLIC_CF_BEACON_TOKEN=your-beacon-token-here